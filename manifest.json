{
  "manifest_version": 3,
  "name": "מוריד וידאו מקומי",
  "version": "2.1",
  "description": "הורדת וידאו באמצעות שרת פייתון מקומי ו-yt-dlp",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "הורד וידאו",
    "default_icon": "icon.png"
  }
}